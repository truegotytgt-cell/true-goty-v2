  /* Ajusta a arena de votação no celular (um card embaixo do outro) */
  main div[style*="display: 'flex'"] {
    flex-direction: column;
  }
  
  /* Ajusta os cards de duelo para ocuparem a tela toda no celular */
  main div[style*="width: '320px'"] {
