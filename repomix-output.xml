}

html, body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background-color: var(--bg-black);
  color: var(--text-light);
  font-family: 'Montserrat', sans-serif;
}

/* REFINO FINO E RESPONSIVIDADE (Para celulares e tablets) */
@media (max-width: 1024px) {
  /* Reduz o padding do topo em telas menores */
  div[style*="paddingTop: '100px'"] {
    padding-top: 140px !important; /* Empurra mais pra baixo porque o header pode quebrar */
  }
}

@media (max-width: 768px) {
  /* Header para mobile */
  header div {
    flex-direction: column;
    gap: 1rem;
  }
  
  nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Reduz o tamanho dos títulos principais em telas de celular */
  h1 {
