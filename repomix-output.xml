        <h1 style={{ color: 'var(--text-light)', fontSize: '2.8rem', marginBottom: '1.5rem', fontWeight: 900, letterSpacing: '-1px' }}>
          INDICADOS <span style={{ color: categoria === 'tgt' ? 'var(--purple-neon)' : '#D4AF37' }}>{categoria.toUpperCase()}</span> 2026
